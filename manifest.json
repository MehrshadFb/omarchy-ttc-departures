{
  "schemaVersion": 1,
  "id": "io.github.mehrshadfb.ttc-departures",
  "name": "TTC Departures",
  "version": "1.0.0",
  "author": "Mehrshad Farahbakhsh",
  "license": "MIT",
  "description": "Live TTC arrivals for your stop in the Omarchy bar: buses, streetcars, and subway, with service alerts, a stop picker, and a trip planner. Free feeds, no API key.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "TTC Departures",
    "description": "Next TTC vehicles at your stop. Click for the board, alerts, stop picker, and trip planner.",
    "category": "Transit",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "stopId": 0,
      "stopName": "",
      "route": "",
      "stop": "",
      "routes": "",
      "maxShown": 2,
      "refreshSeconds": 30,
      "labelStyle": "Minutes",
      "planFrom": "",
      "planTo": ""
    },
    "schema": [
      {
        "key": "stopId",
        "type": "integer",
        "label": "Stop number (or pick one in the panel)",
        "min": 0,
        "max": 99999,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "route",
        "type": "string",
        "label": "Route number, e.g. 501 (alternative to a stop number)",
        "defaultValue": ""
      },
      {
        "key": "stop",
        "type": "string",
        "label": "Stop name words, e.g. Windermere east",
        "defaultValue": ""
      },
      {
        "key": "routes",
        "type": "string",
        "label": "Only these routes, comma separated (blank = all)",
        "defaultValue": ""
      },
      {
        "key": "maxShown",
        "type": "integer",
        "label": "Arrivals shown in the bar",
        "min": 1,
        "max": 4,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 600,
        "step": 15,
        "defaultValue": 30
      },
      {
        "key": "labelStyle",
        "type": "enum",
        "label": "Bar label",
        "options": [
          "Minutes",
          "Route and minutes"
        ],
        "defaultValue": "Minutes"
      }
    ]
  }
}
