{
  "schemaVersion": 1,
  "id": "io.github.mehrshadfb.ttc-departures",
  "name": "TTC Departures",
  "version": "0.1.0",
  "author": "Mehrshad Farahbakhsh",
  "license": "MIT",
  "description": "Next TTC bus and streetcar arrivals for a Toronto stop, right in the Omarchy bar. Uses the free real-time feed, no API key.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "TTC Departures",
    "description": "Minutes until the next TTC vehicles at your stop. Click for the live map, right-click for the full board.",
    "category": "Info",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "stopId": 0,
      "routes": "",
      "maxShown": 2,
      "refreshSeconds": 30,
      "labelStyle": "Minutes"
    },
    "schema": [
      { "key": "stopId", "type": "integer", "label": "TTC stop id (the number on the stop pole)", "min": 0, "max": 99999, "step": 1, "defaultValue": 0 },
      { "key": "routes", "type": "string", "label": "Only these routes, comma separated (blank = all)", "defaultValue": "" },
      { "key": "maxShown", "type": "integer", "label": "Arrivals shown in the bar", "min": 1, "max": 4, "step": 1, "defaultValue": 2 },
      { "key": "refreshSeconds", "type": "integer", "label": "Refresh interval (seconds)", "min": 15, "max": 600, "step": 15, "defaultValue": 30 },
      { "key": "labelStyle", "type": "enum", "label": "Bar label", "options": ["Minutes", "Route and minutes"], "defaultValue": "Minutes" }
    ]
  }
}
