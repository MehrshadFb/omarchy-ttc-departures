#!/bin/bash
# Runs inside the Omarchy VM booted by omarchy-iso-test. Installs this plugin
# from GitHub, puts it on the bar with a real Toronto stop, and screenshots
# the result into $OMARCHY_ACCEPTANCE_DIR, which the harness collects.
set -uo pipefail

PLUGIN_ID="io.github.mehrshadfb.ttc-departures"
PLUGIN_URL="https://github.com/MehrshadFb/omarchy-ttc-departures.git"
ART="${OMARCHY_ACCEPTANCE_DIR:-/tmp/omarchy-acceptance}"
mkdir -p "$ART"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
export WAYLAND_DISPLAY="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' ! -name '*.lock' -printf '%f\n' | head -1)"
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/bin:$PATH"

log() { printf '%s\n' "$*" | tee -a "$ART/log.txt"; }

# The session's Wayland socket can change if the shell or compositor restarts,
# so rediscover it before every capture and say exactly why a capture failed.
find_display() {
  export WAYLAND_DISPLAY="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' ! -name '*.lock' -printf '%f\n' | head -1)"
  export HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
}
shot() {
  find_display
  local err
  if err=$(timeout 10 grim "$ART/$1.png" 2>&1); then
    log "captured $1.png"
  else
    log "grim failed for $1: ${err:-no output} (WAYLAND_DISPLAY=$WAYLAND_DISPLAY)"
  fi
}
health() {
  {
    echo "--- $1 ---"
    echo "wayland sockets: $(ls "$XDG_RUNTIME_DIR" | grep wayland | tr '\n' ' ')"
    echo "hypr instances: $(ls "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | tr '\n' ' ')"
    echo "hyprctl monitors: $(hyprctl -j monitors 2>&1 | head -c 200)"
    echo "quickshell procs: $(pgrep -a quickshell | head -3)"
    echo "shell ping: $(timeout 5 omarchy-shell shell ping 2>&1 | head -1)"
  } >>"$ART/health.txt" 2>&1
}
crop_bar() {
  # Keep the top strip so the bar is readable without zooming into a full desktop.
  magick "$ART/$1.png" -gravity North -crop 0x72+0+0 +repage "$ART/$1-bar.png" 2>/dev/null || true
}

status=0
log "== omarchy version: $(omarchy version 2>/dev/null || cat "$OMARCHY_PATH/version" 2>/dev/null)"
health before-install
shot 00-before-install

log "== plugin add"
if omarchy plugin add "$PLUGIN_URL" --enable --yes >>"$ART/log.txt" 2>&1; then
  log "ok - plugin added"
else
  log "not ok - plugin add failed"; status=1
fi
omarchy plugin list >"$ART/plugin-list.txt" 2>&1
health after-plugin-add
grep -q "$PLUGIN_ID" "$ART/plugin-list.txt" && log "ok - plugin listed" || { log "not ok - plugin not listed"; status=1; }

log "== place on bar and pick the stop by route and name (501, Windermere east)"
omarchy bar put "$PLUGIN_ID" --section right --index 0 >>"$ART/log.txt" 2>&1 || { log "not ok - bar put failed"; status=1; }
omarchy bar set "$PLUGIN_ID" route 501 >>"$ART/log.txt" 2>&1 || log "warn - bar set route failed"
omarchy bar set "$PLUGIN_ID" stop "Windermere east" >>"$ART/log.txt" 2>&1 || log "warn - bar set stop failed"
omarchy bar set "$PLUGIN_ID" labelStyle "Route and minutes" >>"$ART/log.txt" 2>&1 || log "warn - bar set labelStyle failed"
cp ~/.config/omarchy/shell.json "$ART/shell.json" 2>/dev/null || true
health after-bar-set
sleep 40
health before-first-shot
shot 01-route-and-name; crop_bar 01-route-and-name

log "== second stop by number, minutes-only label, three arrivals"
omarchy bar set "$PLUGIN_ID" stopId 6916 --json >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" labelStyle "Minutes" >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" maxShown 3 --json >>"$ART/log.txt" 2>&1 || true
sleep 30
shot 02-minutes-only; crop_bar 02-minutes-only

log "== invalid stop shows the error marker"
omarchy bar set "$PLUGIN_ID" stopId 99999999 --json >>"$ART/log.txt" 2>&1 || true
sleep 20
shot 03-invalid-stop; crop_bar 03-invalid-stop

log "== unmatched stop name shows the question mark"
omarchy bar set "$PLUGIN_ID" stopId 0 --json >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" stop "zzz nowhere" >>"$ART/log.txt" 2>&1 || true
sleep 20
shot 04-no-match; crop_bar 04-no-match

log "== panel: board for stop 14282"
omarchy bar set "$PLUGIN_ID" stop "" >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" route "" >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" stopId 14282 --json >>"$ART/log.txt" 2>&1 || true
sleep 25
omarchy-shell shell summon "$PLUGIN_ID" >>"$ART/log.txt" 2>&1 || log "warn - summon failed"
sleep 4
shot 05-panel-board

log "== panel: stop picker, search for Union"
wtype s; sleep 1
wtype "union"; sleep 4
shot 06-panel-picker
wtype -k Return; sleep 30
shot 07-panel-union-platform
grep -oE '"stopId": *[0-9]+' ~/.config/omarchy/shell.json | head -1 | tee -a "$ART/log.txt"
if grep -qE '"stopId": *13816' ~/.config/omarchy/shell.json; then log "ok - picker persisted stop 13816 to shell.json"; else log "not ok - picker did not persist the stop"; status=1; fi

log "== panel: trip planner Union -> Bathurst Station"
wtype p; sleep 2
shot 08-panel-plan-empty
wtype t; sleep 1
wtype "bathurst station"; sleep 4
wtype -k Return; sleep 25
shot 09-panel-plan-results
if grep -qE '"planTo": *"13760"' ~/.config/omarchy/shell.json; then log "ok - planner persisted destination"; else log "not ok - planTo not found in shell.json"; status=1; fi
wtype -k Escape; sleep 1; wtype -k Escape; sleep 2
shot 10-panel-closed

log "== panel: planner with the same stop twice shows an error"
omarchy-shell shell summon "$PLUGIN_ID" >>"$ART/log.txt" 2>&1 || true
sleep 3
wtype p; sleep 2
wtype t; sleep 1
wtype "union"; sleep 4
wtype -k Return; sleep 4
shot 11-panel-plan-same-stop
wtype -k Escape; sleep 1

log "== panel: picker with no matches"
wtype s; sleep 1
wtype "zzzz qqqq"; sleep 4
shot 12-panel-picker-no-match
wtype -k Escape; sleep 1; wtype -k Escape; sleep 2

log "== panel: no stop chosen yet"
omarchy bar set "$PLUGIN_ID" stopId 0 --json >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" stopName "" >>"$ART/log.txt" 2>&1 || true
sleep 8
shot 13-bar-no-stop; crop_bar 13-bar-no-stop
omarchy-shell shell summon "$PLUGIN_ID" >>"$ART/log.txt" 2>&1 || true
sleep 3
shot 14-panel-no-stop
wtype -k Escape; sleep 2

log "== route filter and label style on a multi-route stop (Queen and Bathurst area, 14282 filtered to 301)"
omarchy bar set "$PLUGIN_ID" stopId 14282 --json >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" routes "301" >>"$ART/log.txt" 2>&1 || true
omarchy bar set "$PLUGIN_ID" labelStyle "Route and minutes" >>"$ART/log.txt" 2>&1 || true
sleep 30
shot 15-bar-route-filter; crop_bar 15-bar-route-filter
omarchy-shell shell summon "$PLUGIN_ID" >>"$ART/log.txt" 2>&1 || true
sleep 3
shot 16-panel-route-filter
wtype -k Escape; sleep 2
omarchy bar set "$PLUGIN_ID" routes "" >>"$ART/log.txt" 2>&1 || true

log "== bar on the left edge (vertical) and back"
omarchy bar position left >>"$ART/log.txt" 2>&1 || log "warn - bar position left failed"
sleep 6
shot 17-vertical-bar
omarchy bar position top >>"$ART/log.txt" 2>&1 || true
sleep 4
cp ~/.config/omarchy/shell.json "$ART/shell-after.json" 2>/dev/null || true
health after-panel

log "== shell diagnostics"
journalctl --user --no-pager -n 600 >"$ART/journal.txt" 2>&1 || true
ls -la ~/.local/state/omarchy/crash* 2>/dev/null >>"$ART/health.txt" || true
grep -iE "ttc|mehrshadfb|BarWidget.qml|Panel.qml|Hub.qml|Model.js" "$ART/journal.txt" >"$ART/journal-plugin.txt" 2>/dev/null || true
if grep -qiE "error|TypeError|ReferenceError|is not a function|Cannot read|undefined" "$ART/journal-plugin.txt"; then
  log "not ok - plugin QML errors in journal (see journal-plugin.txt)"; status=1
else
  log "ok - no plugin QML errors in journal"
fi
ls ~/.local/state/omarchy/ttc-departures 2>/dev/null | head -20 >"$ART/cache-dir.txt" || true
ls "$ART" | tee -a "$ART/log.txt" >/dev/null
log "== done, status $status"
exit $status
